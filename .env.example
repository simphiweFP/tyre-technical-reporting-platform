APP_NAME=Tyre Technical Reporting Platform
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tyre_app:tyre_app@localhost:5432/tyre_reports
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ALLOWED_ORIGINS=http://localhost:4200
SEED_ADMIN_EMAIL=admin@royaltyres.co.za
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_CLAIMS_ADMIN_EMAIL=claims@royaltyres.co.za
# Leave blank to use SEED_ADMIN_PASSWORD, or set a separate password.
SEED_CLAIMS_ADMIN_PASSWORD=
SMTP_HOST=smtp.office365.com
# Docker only: keep mailpit for local testing; set this to the real SMTP host in deployed Docker environments.
SMTP_DOCKER_HOST=mailpit
SMTP_PORT=587
SMTP_USERNAME=royaladmin@royaltyres.co.za
# Keep the working password in your local .env only. Do not commit it to Git.
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=royaladmin@royaltyres.co.za
EMAIL_FROM_NAME=Royal Tyres Technical Reports
PUBLIC_APP_URL=http://localhost:4200
ROYAL_TYRES_LOGO_PATH=
ROYAL_TYRES_REPORT_HEADER_PATH=
ROYAL_TYRES_REPORT_FOOTER_PATH=
ROYAL_TYRES_COMPANY_DETAILS=Royal Tyres · Technical Services
ROYAL_TYRES_PDF_DISCLAIMER=This report records inspection findings at the time of assessment.
REQUEST_RATE_LIMIT_PER_MINUTE=120
REPORT_RETENTION_DAYS=2555
PASSWORD_RESET_MINUTES=30
MAX_DELIVERY_ATTEMPTS=3
DELIVERY_RETRY_MINUTES=5
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# RT-Auth: enable only after registration, role assignment and HTTPS setup.
AUTH_ENABLED=false
AUTH_ISSUER_URL=https://192.168.1.236:8010
AUTH_CLIENT_ID=RT-TechnicalClaim
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=https://192.168.1.236:8020/api/auth/callback
AUTH_CA_FILE=L:/Projects/certs/rootCA.crt
AUTH_TIMEOUT_SECONDS=10
# Explicitly link an existing account using its stable RT-Auth user UUID.
AUTH_USER_LINKS={}
# Map local branch codes to the company and warehouse in RT-Auth.
# Example: {"PHX":{"company":"RTC","warehouse":"RTCPHX"}}
# Empty/unmapped assignments grant no branch data access.
AUTH_BRANCH_SCOPES={}

# Microsoft 365 NDR/bounce monitoring.
# Requires Microsoft Graph application permission Mail.ReadWrite for the mailbox below.
BOUNCE_MONITOR_ENABLED=false
BOUNCE_MONITOR_MAILBOX=royaladmin@royaltyres.co.za
BOUNCE_MONITOR_POLL_SECONDS=60
BOUNCE_MONITOR_LOOKBACK_HOURS=72
BOUNCE_MONITOR_BATCH_SIZE=25
BOUNCE_MONITOR_TIMEOUT_SECONDS=15

JWT_SECRET_FILE=
SMTP_PASSWORD_FILE=
MICROSOFT_CLIENT_SECRET_FILE=
GEMINI_API_KEY_FILE=

# Customer cache: report capture reads JSON only. SAP refreshes the JSON daily or on demand.
CUSTOMER_JSON_PATH=backend/data/customers.json
SAP_CUSTOMER_ENDPOINT=http://localhost:5001/sap/customers
SAP_CUSTOMER_COMPANY_DB=SBK_ROYAL
SAP_CUSTOMER_SEARCH_PARAM=
SAP_CUSTOMER_TIMEOUT_SECONDS=8
SAP_API_KEY_HEADER=X-API-Key
SAP_API_KEY=

# AI image/OCR extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=30

# Independent supplier suggestions for Claims Management
SUPPLIER_JSON_PATH=backend/data/suppliers.json

# Automatically route submitted technical reports to the Claims Administrator.
CLAIMS_AUTO_HANDOVER_ENABLED=true
